<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="UTF-8">
    <title>hell video downloader</title>
    <link rel="icon" href="https://cdn.discordapp.com/icons/1344799827170431016/190d0bbb217258fc54e725f203978650.webp?size=1024" type="image/png">
    <link rel="stylesheet" href="/static/style.css">
</head>
<body>
    <div class="container">
        <h1>🎬 تحميل فيديوهات من

            YouTube ,

            YouTube shorts ,

            TikTok ,

            Instagram .
        </h1>
        <form method="post">
            <input type="text" name="url" placeholder="ألصق رابط الفيديو هنا..." required>
            <button type="submit">تحميل</button>
        </form>

        {% if download_url %}
            <p><a href="{{ download_url }}" download>📥 اضغط هنا لتحميل الفيديو</a></p>
        {% endif %}

        {% if error %}
            <p class="error">⚠️ {{ error }}</p>
        {% endif %}
    </div>

    <p style="margin-top: 30px; color: #0099ff;">جميع الحقوق محفوظة © hell-c 2025</p>
</body>
</html>
