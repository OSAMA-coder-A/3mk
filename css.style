body {
    background-image: url("https://cdn.discordapp.com/banners/1344799827170431016/d22a8047b1e3e3274c347317a9da67de.webp?size=1024");
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    font-family: Arial, sans-serif;
    color: #ffffff;
    text-align: center;
    padding: 50px;
    margin: 0;
}

.container {
    background: rgba(10, 10, 30, 0.5); /* شفافية 50% /
    padding: 40px;
    border-radius: 15px;
    max-width: 600px;
    margin: auto;
    box-shadow: 0 0 20px rgba(0, 200, 255, 0.3);
    backdrop-filter: blur(10px); / يعطي تأثير زجاجي /
    -webkit-backdrop-filter: blur(10px); / للـ Safari */
}

input[type="text"] {
    padding: 12px;
    width: 80%;
    border-radius: 10px;
    border: 1px solid #00c8ff;
    margin-bottom: 20px;
    background-color: #000;
    color: #fff;
    font-size: 16px;
}

input[type="text"]::placeholder {
    color: #999;
}

button {
    padding: 12px 25px;
    border: none;
    background: #00c8ff;
    color: #000;
    font-weight: bold;
    font-size: 16px;
    border-radius: 10px;
    cursor: pointer;
    transition: background 0.3s;
}

button:hover {
    background: #00e6ff;
}

a {
    color: #00e6ff;
    font-weight: bold;
    text-decoration: none;
}

a:hover {
    text-decoration: underline;
}

.error {
    color: #ff4d4d;
    margin-top: 20px;
    font-weight: bold;
}
